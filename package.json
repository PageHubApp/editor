{
  "name": "pagehub-editor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:engine": "tsx --conditions=pagehub-source --test \"packages/engine/test/**/*.test.ts\"",
    "brand:check": "node scripts/rename-brand.mjs --check",
    "check:names": "node scripts/check-names.mjs",
    "parity": "node scripts/parity/parity.mjs",
    "demo": "node scripts/parity/demo/serve.mjs",
    "dev": "pnpm --filter @pagehub/playground dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "check:sites": "tsx --env-file-if-exists=.env.local --conditions=pagehub-source packages/cli/src/bin.ts check",
    "pagehub-editor": "tsx --conditions=pagehub-source packages/cli/src/bin.ts",
    "pagehub": "tsx --conditions=pagehub-source packages/cli/src/bin.ts",
    "build:packages": "pnpm -r --workspace-concurrency=1 --filter \"./packages/*\" build",
    "check:size": "node scripts/check-file-size.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-engine-version.mjs",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@tailwindcss/cli": "4.2.2",
    "@tailwindcss/node": "4.2.2",
    "@tailwindcss/oxide": "4.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "daisyui": "5.5.19",
    "esbuild": "0.28.2",
    "pixelmatch": "8.0.0",
    "playwright": "1.61.1",
    "pngjs": "7.0.0",
    "publint": "0.3.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
