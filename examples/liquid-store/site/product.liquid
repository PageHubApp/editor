<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ product.title }} | {{ site.name }}</title>
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body>
{% render 'header', site: site %}
<main class="band product">
  <img src="{{ product.image | image_url: width: 900 }}" alt="{{ product.title }}" width="900" height="900">
  <div>
    <p class="crumbs"><a href="/products">All plants</a> / {{ product.category | capitalize }}</p>
    <h1>{{ product.title }}</h1>
    <p class="price">
      {% if product.compare_at_price %}<s>{{ product.compare_at_price | money }}</s> {% endif %}{{ product.price | money }}
    </p>
    <p data-editable="text">{{ product.description }}</p>
    <form data-cart="add">
      <input type="hidden" name="id" value="{{ product.handle }}">
      <label>Quantity <input type="number" name="quantity" value="1" min="1" max="10"></label>
      {% if product.available %}
        <button class="button" type="submit">Add to cart</button>
      {% else %}
        <button class="button" type="button" disabled>Sold out</button>
      {% endif %}
    </form>
    <p class="promo">Take 10% off your first order with code <button class="code" type="button" data-copy="SPROUT10">SPROUT10</button></p>
  </div>
</main>
{% render 'footer', site: site %}
</body>
</html>
