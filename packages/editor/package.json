{
  "name": "@pagehub/editor",
  "version": "0.1.0-alpha.0",
  "description": "Embeddable visual editor for HTML + Liquid that edits source in place.",
  "keywords": [
    "html",
    "liquid",
    "editor",
    "visual-editor",
    "react",
    "tailwind",
    "daisyui"
  ],
  "license": "MIT",
  "homepage": "https://github.com/PageHubApp/editor/tree/main/packages/editor#readme",
  "bugs": {
    "url": "https://github.com/PageHubApp/editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PageHubApp/editor.git",
    "directory": "packages/editor"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "pagehub-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "pagehub-source": "./src/components.entry.ts",
      "types": "./dist/components.entry.d.ts",
      "import": "./dist/components.entry.js"
    },
    "./primitives": {
      "pagehub-source": "./src/primitives.entry.ts",
      "types": "./dist/primitives.entry.d.ts",
      "import": "./dist/primitives.entry.js"
    },
    "./styles.css": {
      "pagehub-source": "./styles.css",
      "default": "./dist/styles.css"
    },
    "./styles.tailwind.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-liquid": "6.3.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@floating-ui/react-dom": "2.1.9",
    "@headlessui/react": "2.2.10",
    "@hello-pangea/color-picker": "3.2.2",
    "@pagehub/engine": "workspace:*",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "react-tooltip": "5.30.1"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "daisyui": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "daisyui": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "happy-dom": "21.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tailwindcss/cli": "4.2.2",
    "daisyui": "5.5.19",
    "tailwindcss": "4.2.2"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs && tailwindcss -i styles.css -o dist/styles.css --minify",
    "test": "tsx --conditions=pagehub-source --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
