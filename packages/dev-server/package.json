{
  "name": "@pagehub/dev-server",
  "version": "0.1.0",
  "description": "Local site host for the editor: a Vite plugin, the folder-as-storage file API, per-site Tailwind builds, self-hosted fonts and a chrome-free page preview.",
  "keywords": [
    "html",
    "liquid",
    "editor",
    "vite",
    "dev-server"
  ],
  "license": "MIT",
  "homepage": "https://github.com/PageHubApp/editor/tree/main/packages/dev-server#readme",
  "bugs": {
    "url": "https://github.com/PageHubApp/editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PageHubApp/editor.git",
    "directory": "packages/dev-server"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "pagehub-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "pagehub-source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pagehub/engine": "workspace:*",
    "@pagehub/site-runtime": "workspace:*",
    "@tailwindcss/node": "4.2.2",
    "@tailwindcss/oxide": "4.2.2",
    "daisyui": "5.5.19",
    "esbuild": "0.28.2",
    "tailwindcss": "4.2.2"
  },
  "peerDependencies": {
    "@pagehub/editor": "workspace:*",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@pagehub/editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pagehub/editor": "workspace:*",
    "vite": "8.3.5"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "tsx --conditions=pagehub-source --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
